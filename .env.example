TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# Stage A — prompt architect (any OpenAI chat model)
TEXT_MODEL=gpt-4o

# Stage B — image renderer
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE_HORIZONTAL=1824x1024
IMAGE_SIZE_VERTICAL=1024x1824
IMAGE_QUALITY=high

# Ground generations on real samples from images-sample/
STYLE_REFERENCE_ENABLED=true
STYLE_REFERENCE_COUNT=2
STYLE_REFERENCE_DIR=images-sample

# Auto-delete each saved copy in storage/generations/ this many seconds after creation
GENERATION_RETENTION_SECONDS=300
